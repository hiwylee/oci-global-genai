# OCI Generative AI API 키. 실제 값은 .env에만 넣고 절대 커밋하지 마세요.
# API 키는 리전 리소스이므로 케이스별 엔드포인트 리전에서 만든 키를 각각 넣는다.
# CASE_X_API_KEY가 없으면 OCI_GENAI_API_KEY를 공통으로 사용한다.
OCI_GENAI_API_KEY=
CASE_A_API_KEY=
CASE_B_API_KEY=

# Case A — "Route Model Requests Across OCI Regions" 튜토리얼 패턴
# 로컬 모델 처리가 있는 리전(Chicago) 엔드포인트 + 다중 타깃 라우팅 프로파일
CASE_A_REGION=us-chicago-1
CASE_A_PROFILE_OCID=
CASE_A_MODEL_LABEL=xai.grok-4.3

# Case B — "Global Generative AI availability" (2026-10-20)
# 로컬 모델 처리가 없는 Seoul 엔드포인트 + Chicago 단일 타깃 라우팅 프로파일
CASE_B_REGION=ap-seoul-1
CASE_B_PROFILE_OCID=
CASE_B_MODEL_LABEL=xai.grok-4.3

# Case C — 벡터 스토어 / File Search (Enterprise AI Agents)
# 벡터 스토어 생성/목록/조회는 컨트롤 플레인(https://generativeai.{region}.oci.oraclecloud.com/20231130/openai/v1)에
# OCI 요청 서명(API 키 아님)으로 호출하며 컴파트먼트 OCID가 필요하다.
COMPARTMENT_OCID=
# Files / 벡터 스토어 호출에 쓰는 OpenAI-Project 헤더 값 (Generative AI 프로젝트 OCID, 엔드포인트 리전별)
CASE_A_PROJECT_OCID=
CASE_B_PROJECT_OCID=
# 컨트롤 플레인 서명에 쓸 ~/.oci/config 프로파일 이름
CASE_A_OCI_PROFILE=YWDCLOUD_CHICAGO
CASE_B_OCI_PROFILE=YWDCLOUD
# 화면에 미리 선택해 둘 벡터 스토어 ID (선택)
CASE_C_VECTOR_STORE_ID=
# file_search에 쓸 모델. 라우팅 프로파일 OCID는 tools와 함께 쓰면 400이 나므로 모델 이름을 직접 넣는다.
CASE_C_MODEL=xai.grok-4.3

# Case D — OCI SDK 네이티브 API (embed / rerank / chat)
# 사용자 principal 서명: CASE_A_OCI_PROFILE / CASE_B_OCI_PROFILE 프로파일과 COMPARTMENT_OCID를 그대로 쓴다.
# Seoul 라우팅 프로파일 매핑 (모델 이름 → 프로파일 OCID, JSON 객체 문자열, 선택).
# xai.grok-4.3은 없으면 CASE_B_PROFILE_OCID를 사용한다.
# 예: CASE_B_PROFILES_JSON={"openai.gpt-oss-120b":"ocid1.generativeairoutingprofile.oc1.ap-seoul-1....","cohere.command-a-03-2025":"ocid1...."}
CASE_B_PROFILES_JSON=
